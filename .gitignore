# Home is the worktree: ignore everything, allowlist below
*

!.gitignore
!.zshrc
!.bashrc

!.shell/
!.shell/*.sh
# secrets and machine overrides
.shell/local.sh

!bin/
!bin/cluster

!.github/
!.github/README.md

# .claude is the native home of rules, agents, skills
!.claude/
!.claude/CLAUDE.md
!.claude/agents/
!.claude/agents/*.md
!.claude/skills/
!.claude/skills/**
!.claude/commands/
!.claude/commands/**
.claude/skills/synced/

# editor cruft, re-excluded after the allowlist
.*.sw?
*.sw?
.DS_Store
