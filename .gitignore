# Home is the worktree: ignore everything, allowlist below
*

!.gitignore
!.zshrc
!.bashrc

!.shell/
!.shell/*.sh
# secrets and machine overrides
.shell/local.sh

!bin/
!bin/cluster

!.github/
!.github/README.md

# opencode is the native home of rules, agents, skills
!.config/
!.config/opencode/
!.config/opencode/AGENTS.md
!.config/opencode/agents/
!.config/opencode/agents/*.md
!.config/opencode/skills/
!.config/opencode/skills/**
# synced by another tool
.config/opencode/skills/synced/

# committed symlinks into .config/opencode
!.claude/
!.claude/CLAUDE.md
!.claude/agents
!.claude/skills

# editor cruft, re-excluded after the allowlist
.*.sw?
*.sw?
.DS_Store
